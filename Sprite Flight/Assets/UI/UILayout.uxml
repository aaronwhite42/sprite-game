<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ControlPanel" style="align-self: center; width: 420px; margin-top: 10px; padding-top: 6px; padding-right: 12px; padding-bottom: 6px; padding-left: 12px; background-color: rgba(0, 0, 0, 0.55); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;">
        <ui:Label text="Walls: 300 K    Gas: 300 K" name="TemperatureLabel" style="align-self: center; font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255);"/>
        <ui:Slider name="TemperatureSlider" low-value="50" high-value="1000" value="300" style="margin-top: 4px;"/>
    </ui:VisualElement>
</ui:UXML>
